# Supabase > Connect; public credentials protected by RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Server only: contact inbox and optional analytics
SUPABASE_SECRET_KEY=
# Random 32+ character key for hashing abuse-control identifiers
CONTACT_RATE_LIMIT_SECRET=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Only for admin:create script
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Disposable test database credentials for integration/E2E tests
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# Optional local-only Auth provisioning token (generated by configure-local; expires in 24h)
SUPABASE_AUTH_ADMIN_TOKEN=
